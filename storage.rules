rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function signedIn(){return request.auth != null;}
  function activeUser(){
    return signedIn() &&
      firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.active == true;
  }

  // Visitor photographs are operational records. Any active authenticated
  // VMS login may read/upload them; the application still writes them under
  // the visitorPhotos/<locationId>/ path for location traceability.
  match /visitorPhotos/{locationId}/{fileName} {
    allow read: if activeUser();
    allow write: if activeUser();
  }
 }
  // The login logo is intentionally public because the login screen is shown before authentication.
  // Only an active administrator may replace it.
  match /loginBranding/{fileName} {
    allow read: if true;
    allow write: if signedIn() &&
      firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
      firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.active == true;
  }

}
