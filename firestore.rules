rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function me(){return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;}
  function admin(){return signedIn() && me().role == 'admin' && me().active == true;}
  function security(){return signedIn() && me().role == 'security' && me().active == true;}
  function sameLocation(resourceData){return admin() || (security() && resourceData.locationId == me().locationId);}
  match /users/{uid} { allow read: if signedIn() && (request.auth.uid==uid || admin()); allow create,update,delete: if admin(); }
  match /locations/{id} { allow read: if signedIn(); allow write: if admin(); }
  match /settings/{id} { allow read: if signedIn(); allow write: if admin(); }
  match /securityPersons/{id} {
    allow read: if admin() || (security() && resource.data.locationId == me().locationId);
    allow create,update,delete: if admin();
  }
  match /deskSessions/{locationId} {
    allow read: if admin() || (security() && resource.data.locationId == me().locationId);
    allow create: if admin() || (security() && request.resource.data.locationId == me().locationId && request.resource.data.startedBy == request.auth.uid);
    allow update: if admin() || (security() && resource.data.locationId == me().locationId && resource.data.startedBy == request.auth.uid && request.resource.data.locationId == me().locationId && request.resource.data.startedBy == request.auth.uid);
    allow delete: if admin();
  }
  match /visitorCounters/{day} { allow read: if admin() || security(); allow create: if admin() || (security() && request.resource.data.nextNumber == 2); allow update: if admin() || (security() && request.resource.data.nextNumber == resource.data.nextNumber + 1); allow delete: if admin(); }
  match /visitors/{id} { allow read: if sameLocation(resource.data); allow create: if sameLocation(request.resource.data); allow update: if sameLocation(resource.data) && sameLocation(request.resource.data); allow delete: if admin(); }
  match /assets/{id} { allow read: if sameLocation(resource.data); allow create: if sameLocation(request.resource.data); allow update: if sameLocation(resource.data) && sameLocation(request.resource.data); allow delete: if admin(); }
  match /gatePasses/{id} { allow read: if sameLocation(resource.data); allow create: if sameLocation(request.resource.data); allow update: if sameLocation(resource.data) && sameLocation(request.resource.data); allow delete: if admin(); }
  match /internalTransfers/{id} {
    allow read: if admin() || (security() && (resource.data.sourceLocationId == me().locationId || resource.data.destinationLocationId == me().locationId));
    allow create: if admin() || (security() && request.resource.data.sourceLocationId == me().locationId);
    allow update: if admin() || (security() && resource.data.destinationLocationId == me().locationId && request.resource.data.sourceLocationId == resource.data.sourceLocationId && request.resource.data.destinationLocationId == resource.data.destinationLocationId && resource.data.status == 'SENT' && request.resource.data.status == 'RECEIVED_CLOSED');
    allow delete: if admin();
  }
  match /assetMovementEvents/{id} { allow read: if admin() || (security() && resource.data.locationIds is list && resource.data.locationIds.hasAny([me().locationId])); allow create: if admin() || (security() && request.resource.data.locationIds is list && request.resource.data.locationIds.hasAny([me().locationId])); allow update,delete: if false; }
  match /auditLogs/{id} { allow read: if admin(); allow create: if signedIn(); allow update,delete: if false; }
 }
}