rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function me(){return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;}
  function admin(){return signedIn() && me().role == 'admin' && me().active != false;}
  function security(){return signedIn() && me().role == 'security' && me().active != false;}
  function official(){return signedIn() && me().role == 'official' && me().active != false;}
  function moduleEnabled(moduleName){
    return admin() || !('accessTabs' in me()) || (me().accessTabs is list && me().accessTabs.hasAny([moduleName]));
  }
  // Older warehouse user profiles may contain the human-readable location label
  // (for example "Warehouse I") instead of the canonical location document ID ("I").
  // Keep access scoped to that one assigned location while supporting both formats.
  function myLocationMatches(locationId){
    return locationId == me().locationId
      || (me().locationId == 'Main Admin Office' && locationId == 'ADMIN')
      || (me().locationId == 'Warehouse I' && locationId == 'I')
      || (me().locationId == 'Warehouse J' && locationId == 'J')
      || (me().locationId == 'Warehouse K' && locationId == 'K')
      || (me().locationId == 'Warehouse L' && locationId == 'L')
      || (me().locationId == 'Warehouse O' && locationId == 'O')
      || (me().locationId == 'Warehouse P' && locationId == 'P')
      || (me().locationId == 'Warehouse Q' && locationId == 'Q')
      || (me().locationId == 'Warehouse R' && locationId == 'R')
      || (me().locationId == 'Warehouse S' && locationId == 'S')
      || (me().locationId == 'Warehouse T' && locationId == 'T')
      || (me().locationId in ['H14(MHE)', 'H14 (MHE)', 'H14-MHE'] && locationId == 'H14-MHE');
  }
  function myLocationInList(ids){
    return ids.hasAny([me().locationId])
      || (me().locationId == 'Main Admin Office' && ids.hasAny(['ADMIN']))
      || (me().locationId == 'Warehouse I' && ids.hasAny(['I']))
      || (me().locationId == 'Warehouse J' && ids.hasAny(['J']))
      || (me().locationId == 'Warehouse K' && ids.hasAny(['K']))
      || (me().locationId == 'Warehouse L' && ids.hasAny(['L']))
      || (me().locationId == 'Warehouse O' && ids.hasAny(['O']))
      || (me().locationId == 'Warehouse P' && ids.hasAny(['P']))
      || (me().locationId == 'Warehouse Q' && ids.hasAny(['Q']))
      || (me().locationId == 'Warehouse R' && ids.hasAny(['R']))
      || (me().locationId == 'Warehouse S' && ids.hasAny(['S']))
      || (me().locationId == 'Warehouse T' && ids.hasAny(['T']))
      || (me().locationId in ['H14(MHE)', 'H14 (MHE)', 'H14-MHE'] && ids.hasAny(['H14-MHE']));
  }
  function sameLocation(resourceData){return admin() || (security() && myLocationMatches(resourceData.locationId));}
  match /users/{uid} { allow read: if signedIn() && (request.auth.uid==uid || admin()); allow create,update,delete: if admin(); }
  // Shared notifications are stored once per location/source so every login assigned
  // to that location sees the same feed and read state. Admin accounts share the global feed.
  match /locationNotifications/{id} {
    allow get: if admin() || (security() && moduleEnabled('notifications') && (resource == null || myLocationMatches(resource.data.locationId)));
    allow list: if admin() || (security() && moduleEnabled('notifications') && myLocationMatches(resource.data.locationId));
    allow create: if admin() || (security() && moduleEnabled('notifications') && myLocationMatches(request.resource.data.locationId));
    allow update: if admin() || (security() && moduleEnabled('notifications') && myLocationMatches(resource.data.locationId) && myLocationMatches(request.resource.data.locationId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read','readAt','readBy','clearedAt','clearedBy']));
    allow delete: if admin();
  }
  match /userNotifications/{id} {
    allow get: if official() && (resource == null || resource.data.recipientUid == request.auth.uid);
    allow list: if official() && resource.data.recipientUid == request.auth.uid;
    allow create: if official() && request.resource.data.recipientUid == request.auth.uid;
    allow update: if official() && resource.data.recipientUid == request.auth.uid && request.resource.data.recipientUid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read','readAt','readBy','clearedAt','clearedBy']);
    allow delete: if false;
  }
  match /appointmentOfficials/{id} {
    allow read: if true;
    allow create,update,delete: if admin();
  }
  match /locations/{id} { allow read: if signedIn(); allow write: if admin(); }
  match /settings/{id} { allow read: if signedIn(); allow write: if admin(); }
  match /publicSettings/{id} {
    allow read: if id in ["appointment","loginBranding"];
    allow write: if admin();
  }
  match /securityPersons/{id} {
    allow read: if admin() || (security() && (moduleEnabled('visitors') || moduleEnabled('appointments')) && myLocationMatches(resource.data.locationId));
    allow create,update,delete: if admin();
  }
  match /deskSessions/{locationId} {
    allow read: if admin() || (security() && (moduleEnabled('visitors') || moduleEnabled('appointments')) && myLocationMatches(resource.data.locationId));
    allow create: if admin() || (security() && (moduleEnabled('visitors') || moduleEnabled('appointments')) && myLocationMatches(request.resource.data.locationId) && request.resource.data.startedBy == request.auth.uid);
    allow update: if admin() || (security() && (moduleEnabled('visitors') || moduleEnabled('appointments')) && myLocationMatches(resource.data.locationId) && myLocationMatches(request.resource.data.locationId) && (
      (resource.data.status != 'ACTIVE' && request.resource.data.status == 'ACTIVE' && request.resource.data.startedBy == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['locationId','securityPersonId','securityPersonName','status','startedAt','startedBy','startedByName','endedAt','endedBy','endedByName']))
      || (resource.data.status == 'ACTIVE' && request.resource.data.status == 'ENDED' && request.resource.data.startedBy == resource.data.startedBy && request.resource.data.endedBy == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','endedAt','endedBy','endedByName']))
    ));
    allow delete: if admin();
  }
  match /visitorCounters/{day} { allow read: if admin() || (security() && (moduleEnabled('visitors') || moduleEnabled('appointments'))); allow create: if admin() || (security() && (moduleEnabled('visitors') || moduleEnabled('appointments')) && request.resource.data.nextNumber == 2); allow update: if admin() || (security() && (moduleEnabled('visitors') || moduleEnabled('appointments')) && request.resource.data.nextNumber == resource.data.nextNumber + 1); allow delete: if admin(); }
  match /nonRoutineVisitorCounters/{day} { allow read: if admin() || (security() && moduleEnabled('nonRoutineVisitors')); allow create: if admin() || (security() && moduleEnabled('nonRoutineVisitors') && request.resource.data.nextNumber == 2); allow update: if admin() || (security() && moduleEnabled('nonRoutineVisitors') && request.resource.data.nextNumber == resource.data.nextNumber + 1); allow delete: if admin(); }
  match /visitorAppointments/{id} {
    // Public booking is login-free. Decisions are restricted to the named official,
    // the destination security desk after delegation / Others routing, or an admin.
    allow create: if request.resource.data.status == 'PENDING'
      && request.resource.data.locationId in ['ADMIN','I','J','K','L','O','P','Q','R','S','T','H14-MHE'];

    allow read: if admin()
      || (security() && moduleEnabled('appointments') && myLocationMatches(resource.data.locationId))
      || (official() && resource.data.hostId == request.auth.uid);

    allow update: if admin()
      || (security()
        && moduleEnabled('appointments')
        && myLocationMatches(resource.data.locationId)
        && request.resource.data.locationId == resource.data.locationId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','reviewedAt','reviewedBy','reviewedByName','reviewedByRole','rejectionReason',
          'approvalMode','passedToSecurityAt','passedToSecurityBy','passedToSecurityByName',
          'noShowAt','visitorId','checkedInAt','checkedInBy','checkedInByName',
          'checkedOutAt','checkedOutBy','checkedOutByName','updatedAt'
        ]))
      || (official()
        && resource.data.hostId == request.auth.uid
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.locationId == resource.data.locationId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','reviewedAt','reviewedBy','reviewedByName','reviewedByRole','rejectionReason',
          'approvalMode','passedToSecurityAt','passedToSecurityBy','passedToSecurityByName','updatedAt'
        ]));

    allow delete: if admin();
  }
  match /nonRoutineVisitors/{id} {
    allow read: if admin() || (security() && moduleEnabled('nonRoutineVisitors') && myLocationMatches(resource.data.locationId));
    allow create: if admin() || (security() && moduleEnabled('nonRoutineVisitors') && myLocationMatches(request.resource.data.locationId));
    allow update: if admin() || (security() && moduleEnabled('nonRoutineVisitors') && myLocationMatches(resource.data.locationId) && myLocationMatches(request.resource.data.locationId));
    allow delete: if admin();
  }
  match /visitors/{id} { allow read: if admin() || (security() && (moduleEnabled('visitors') || moduleEnabled('appointments')) && myLocationMatches(resource.data.locationId)); allow create: if admin() || (security() && (moduleEnabled('visitors') || moduleEnabled('appointments')) && myLocationMatches(request.resource.data.locationId)); allow update: if admin() || (security() && (moduleEnabled('visitors') || moduleEnabled('appointments')) && myLocationMatches(resource.data.locationId) && myLocationMatches(request.resource.data.locationId)); allow delete: if admin(); }
  match /assets/{id} { allow read: if admin() || (security() && moduleEnabled('assets') && myLocationMatches(resource.data.locationId)); allow create: if admin() || (security() && moduleEnabled('assets') && myLocationMatches(request.resource.data.locationId)); allow update: if admin() || (security() && moduleEnabled('assets') && myLocationMatches(resource.data.locationId) && myLocationMatches(request.resource.data.locationId)); allow delete: if admin(); }
  match /gatePasses/{id} { allow read: if admin() || (security() && (moduleEnabled('gatepasses') || moduleEnabled('assets')) && myLocationMatches(resource.data.locationId)); allow create: if admin() || (security() && (moduleEnabled('gatepasses') || moduleEnabled('assets')) && myLocationMatches(request.resource.data.locationId)); allow update: if admin() || (security() && (moduleEnabled('gatepasses') || moduleEnabled('assets')) && myLocationMatches(resource.data.locationId) && myLocationMatches(request.resource.data.locationId)); allow delete: if admin(); }
  match /internalTransfers/{id} {
    allow read: if admin() || (security() && moduleEnabled('transfers') && (myLocationMatches(resource.data.sourceLocationId) || myLocationMatches(resource.data.destinationLocationId)));
    allow create: if admin() || (security() && moduleEnabled('transfers') && myLocationMatches(request.resource.data.sourceLocationId));
    allow update: if admin() || (security() && moduleEnabled('transfers') && myLocationMatches(resource.data.destinationLocationId) && request.resource.data.sourceLocationId == resource.data.sourceLocationId && request.resource.data.destinationLocationId == resource.data.destinationLocationId && resource.data.status == 'SENT' && request.resource.data.status == 'RECEIVED_CLOSED');
    allow delete: if admin();
  }
  match /assetMovementEvents/{id} { allow read: if admin() || (security() && moduleEnabled('assetTimeline') && resource.data.locationIds is list && myLocationInList(resource.data.locationIds)); allow create: if admin() || (security() && (moduleEnabled('assets') || moduleEnabled('transfers') || moduleEnabled('gatepasses')) && request.resource.data.locationIds is list && myLocationInList(request.resource.data.locationIds)); allow update,delete: if false; }
  match /auditLogs/{id} { allow read: if admin(); allow create: if signedIn(); allow update,delete: if false; }
 }
}